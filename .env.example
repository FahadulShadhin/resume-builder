# Google Drive OAuth 2.0 credentials (Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID, Desktop app type)
GOOGLE_DRIVE_CLIENT_ID=your_google_drive_client_id
GOOGLE_DRIVE_CLIENT_SECRET=your_google_drive_client_secret

# Optional: token cache path for the Drive OAuth flow (defaults to ./token.json)
GOOGLE_DRIVE_TOKEN_PATH=./token.json
